# Copy this file to .env and fill it in. Never share or commit .env - the feed URL is private.

# Canvas -> Calendar -> "Calendar Feed" (bottom right of the page) -> copy the URL.
# Looks like https://<your-school>.instructure.com/feeds/calendars/user_XXXX.ics
# (UBC: https://canvas.ubc.ca/feeds/calendars/user_XXXX.ics)
CANVAS_ICS_URL=

# A long, random, hard-to-guess name. Anyone who knows it can read your notifications.
# Subscribe to this exact topic in the ntfy app on every device.
NTFY_TOPIC=canvas-reminder-CHANGE-ME-to-something-random
NTFY_SERVER=https://ntfy.sh

# How many days ahead the daily digest looks
DAYS_AHEAD=7

# Your timezone (IANA name), e.g. America/Vancouver, America/Toronto, America/New_York
TIMEZONE=America/Vancouver
